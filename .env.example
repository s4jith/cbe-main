# Copy to .env.local (or .env) and fill in. Never commit the filled-in file.

# --- database & Payload ------------------------------------------------------
MONGODB_URI=
PAYLOAD_SECRET=

# --- media storage -----------------------------------------------------------
BLOB_READ_WRITE_TOKEN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- contact form email (Resend) ---------------------------------------------
# Server-side only. Without RESEND_API_KEY the site still stores submissions and
# simply logs the emails instead of sending them.
RESEND_API_KEY=

# The sender address. `onboarding@resend.dev` is Resend's sandbox sender: it can
# only deliver to the email address that owns the Resend account, which is enough
# for testing. Swap it for an address on a verified domain before launch.
EMAIL_FROM=onboarding@resend.dev

# Where contact-form notifications are sent.
ADMIN_EMAIL=

# Absolute site origin, used to make image URLs in emails absolute.
NEXT_PUBLIC_SITE_URL=
